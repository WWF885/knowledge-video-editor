{
  "$comment": "全局默认参数。所有脚本从这里读，不要把数值写死在代码里。",
  "version": "1.0.0",
  "defaults": {
    "aspect_ratio": "auto",
    "theme": "auto",
    "fps": 30,
    "audio": {
      "sample_rate": 48000,
      "channels": 2,
      "target_lufs": -16,
      "true_peak": -1.5,
      "lra": 11,
      "denoise": { "enabled": true, "nf": -25, "nr": 12 },
      "highpass_hz": 80
    },
    "bgm": { "enabled": true, "volume_db": -22, "duck_db": -30, "release_s": 0.3 },
    "sfx": { "density_per_10s": [1, 3], "min_gap_s": 0.8 },
    "cover": {
      "duration_s": 2.0,
      "max_lines": 2,
      "max_chars_per_line": 4,
      "font_weight": "heavy",
      "push_zoom": [1.0, 1.04],
      "export_png": true
    },
    "navigation": {
      "enabled_horizontal": true,
      "enabled_vertical": true,
      "chapters_min": 3,
      "chapters_max": 6,
      "chapter_name_max_chars": 6,
      "height_ratio_max": 0.08,
      "transition_ms": [300, 500],
      "hide_during_cover": true
    },
    "storyboard": { "evaluate_composition_every_s": 3, "max_same_layout_s": 9, "read_hold_ratio": [0.15, 0.25] },
    "subtitles": {
      "layout": "chinese_above_english",
      "zh_max_chars_per_line": 18,
      "en_max_chars_per_line": 60,
      "max_emphasis_per_line": 1,
      "sync_tolerance_s": 0.15
    },
    "quality": { "pass_score": 90, "auto_fix_max_rounds": 2 },
    "paths": {
      "work_dir": "work",
      "output_dir": "output",
      "deliverables": [
        "01_最终成片.mp4",
        "02_首帧封面.png",
        "03_精剪原声视频.mp4",
        "04_中英双语字幕.srt",
        "05_完整口播文稿.md",
        "06_全片导演计划.json",
        "07_逐秒分镜计划.json",
        "08_自动质检报告.md",
        "09_可编辑视频工程"
      ]
    }
  }
}
